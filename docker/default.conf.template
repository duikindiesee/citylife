# CityLife in-cluster nginx config. Rendered by the nginx image's envsubst at container start
# (only the CITYLIFE_*/KOOKER_GATEWAY vars are substituted via NGINX_ENVSUBST_FILTER; the
# $-prefixed nginx runtime variables are left intact). Serves the static SPA AND proxies /kooker
# to the gateway like the vite dev proxy, so a production build reaches kooker the same way.

# Shared declarations: effective only when referenced by the chosen access log format.
# $uri is normalized; raw $request_uri catches later internal rewrites and denials.
map $uri $citylife_ws_normalized {
    default 0;
    ~^/(?:kooker/)?api/v1/citylife/(?:ws|browser-ws|auth/cookie|auth/clear)(?:/|$) 1;
}
map $request_uri $citylife_ws_original {
    default 0;
    ~^/(?:kooker/)?api/v1/citylife/(?:ws|browser-ws|auth/cookie|auth/clear)(?:[/?]|$) 1;
}
map "$citylife_ws_normalized$citylife_ws_original" $citylife_ws_log_safe {
    default 0;
    ~1 1;
}
map $citylife_ws_log_safe $citylife_log_request {
    default $request;
    1 "$request_method $uri $server_protocol";
}
# Any query-like Referer on any route is a deliberate narrow exception to
# otherwise byte-identical unrelated-route access diagnostics.
map $http_referer $citylife_log_referer {
    default $http_referer;
    "" "-";
    ~*(?:\?|%3f) "-";
}

# Conditional public scheme mapping for CityLife BFF and browser WebSocket routes.
# Propagates verified single-token scheme from ingress ("https" or "http");
# any missing, multiple, or unrecognized scheme safely defaults to local $scheme.
map $http_x_forwarded_proto $citylife_public_scheme {
    default $scheme;
    ~*^https$ https;
    ~*^http$ http;
}

log_format sanitized_wss '$remote_addr - [$time_local] "$request_method $uri" '
                         '$status $upstream_status $request_time';

# Server-default safe combined format: reproduces standard nginx combined format bytes for ordinary requests,
# while stripping query strings on sensitive socket paths (including trailing slashes and fallbacks)
# and sanitizing query-bearing Referers across all routes.
log_format safe_combined '$remote_addr - $remote_user [$time_local] '
                         '"$citylife_log_request" $status $body_bytes_sent '
                         '"$citylife_log_referer" "$http_user_agent" "$http_x_forwarded_for"';

server {
    listen 80;
    server_name localhost;

    access_log /var/log/nginx/access.log safe_combined;

    root /usr/share/nginx/html;
    index index.html index.htm;

    # Correct MIME types — three.js ships ES modules that must be served as application/javascript.
    include /etc/nginx/mime.types;
    types {
        application/javascript js mjs;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Liveness/readiness for k8s probes.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # Runtime config the SPA fetches on boot to choose its reply source. Holds NO secret —
    # just whether the proxy is wired for real Hermes ("kooker") or mock stand-ins.
    location = /citylife-runtime.json {
        access_log off;
        default_type application/json;
        return 200 '{"botBackend":"${CITYLIFE_BOT_BACKEND}","model":"${CITYLIFE_MODEL}"}';
    }

    # Inference route — forwards the player's OWN kooker JWT through to the choke point. The browser
    # sends Authorization: Bearer <session token> (the logged-in player's), and nginx passes it
    # upstream unchanged (no proxy_set_header Authorization override here, so the client header flows
    # through). No shared PAT, no secret in the cluster — inference is attributed to the real user.
    # Exact match kept only to stamp the rate-limit tier header.
    location = /kooker/api/v1/ai/route/chat {
        proxy_pass ${KOOKER_GATEWAY}/api/v1/ai/route/chat;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host ${KOOKER_HOST};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Kooker-Tier external;
    }

    # Compatibility for a CityLife tab that loaded the former bare auth paths before the frontend
    # moved all gateway calls behind /kooker. Keep this deliberately limited to the two auth calls:
    # proxying the whole /api tree would create a second, easy-to-forget public gateway surface.
    # New bundles use /kooker/api/auth/* and flow through the generic block below.
    location = /api/auth/basic {
        proxy_pass ${KOOKER_GATEWAY}/api/auth/basic;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host ${KOOKER_HOST};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/auth/refresh {
        proxy_pass ${KOOKER_GATEWAY}/api/auth/refresh;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host ${KOOKER_HOST};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # CityLife auth cookie issuance BFF proxy (direct and /kooker alias)
    location = /kooker/api/v1/citylife/auth/cookie {
        proxy_pass ${KOOKER_GATEWAY}/api/v1/citylife/auth/cookie;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host citylife-ws.internal;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $citylife_public_scheme;
        proxy_pass_header Set-Cookie;
    }

    location = /api/v1/citylife/auth/cookie {
        proxy_pass ${KOOKER_GATEWAY}/api/v1/citylife/auth/cookie;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host citylife-ws.internal;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $citylife_public_scheme;
        proxy_pass_header Set-Cookie;
    }

    # CityLife auth cookie clear BFF proxy (direct and /kooker alias)
    location = /kooker/api/v1/citylife/auth/clear {
        proxy_pass ${KOOKER_GATEWAY}/api/v1/citylife/auth/clear;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host citylife-ws.internal;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $citylife_public_scheme;
        proxy_pass_header Set-Cookie;
    }

    location = /api/v1/citylife/auth/clear {
        proxy_pass ${KOOKER_GATEWAY}/api/v1/citylife/auth/clear;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host citylife-ws.internal;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $citylife_public_scheme;
        proxy_pass_header Set-Cookie;
    }

    # CityLife multiplayer WebSocket proxy with connection upgrade.
    # Browser client connects here; site rewrites upstream to /api/v1/citylife/browser-ws
    # under constant internal Host citylife-ws.internal.
    # PRESERVES Cookie, removes incoming Authorization so Server15 browser policy is enforced.
    location = /kooker/api/v1/citylife/ws {
        access_log /var/log/nginx/access.log sanitized_wss;
        proxy_pass ${KOOKER_GATEWAY}/api/v1/citylife/browser-ws;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host citylife-ws.internal;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $citylife_public_scheme;
        proxy_set_header Authorization "";
        proxy_pass_header Cookie;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Compatibility for direct /api/v1/citylife/ws WebSocket route
    location = /api/v1/citylife/ws {
        access_log /var/log/nginx/access.log sanitized_wss;
        proxy_pass ${KOOKER_GATEWAY}/api/v1/citylife/browser-ws;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host citylife-ws.internal;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $citylife_public_scheme;
        proxy_set_header Authorization "";
        proxy_pass_header Cookie;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Deny direct public access to internal browser-ws endpoints (both direct and /kooker alias)
    location ~ ^/(?:kooker/)?api/v1/citylife/browser-ws(?:/|$) {
        return 404;
    }

    # Reject trailing slashes and encoded query path variants on sensitive API and WebSocket endpoints (prevent SPA fallback or generic proxying)
    location ~ ^/(?:kooker/)?api/v1/citylife/(?:ws|auth/cookie|auth/clear)(?:/|%3[fF]|\?) {
        return 404;
    }

    # All other kooker API calls (registration, etc.) — proxied WITHOUT injected auth.
    location /kooker/ {
        proxy_pass ${KOOKER_GATEWAY}/;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host ${KOOKER_HOST};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build assets: 404 if missing, never fall back to index.html for a .js/.css request.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* \.(js|mjs|css|png|jpg|jpeg|gif|ico|svg|woff2?|ttf|eot|glb|gltf|hdr|wasm)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, no-transform";
    }

    # /ask is the friendly path for the Ask-Kooker board (built as ask-kooker.html). Serve the page
    # content at /ask (and /ask/) with no redirect, so the pretty URL stays in the address bar. Exact
    # matches, so this never shadows /assets, the /kooker proxy, or the SPA fallback below.
    location = /ask {
        try_files /ask-kooker.html =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }
    location = /ask/ {
        try_files /ask-kooker.html =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }
    # The extensionless form of the built filename resolves too, so a collaborator
    # who drops the .html still lands on the board instead of the SPA login.
    location = /ask-kooker {
        try_files /ask-kooker.html =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }
    location = /ask-kooker/ {
        try_files /ask-kooker.html =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    # SPA history fallback for client-side routing only.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }
}
